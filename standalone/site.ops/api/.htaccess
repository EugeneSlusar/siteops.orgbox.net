# Точка входа: доступ разрешён (остальное в site.ops закрыто). Служебные файлы .ht* по-прежнему недоступны.
<IfModule mod_authz_core.c>
    Require all granted
    <FilesMatch "^\.ht">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Allow from all
    <FilesMatch "^\.ht">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
