# orgBox SiteOps: наружу открыты только три точки входа, всё остальное (код, резервные копии) закрыто.
Options -Indexes

<IfModule mod_authz_core.c>
    Require all denied
    <FilesMatch "^(mcp|api|admin)\.php$">
        Require all granted
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
    <FilesMatch "^(mcp|api|admin)\.php$">
        Allow from all
    </FilesMatch>
</IfModule>
